# Copy to infra/.env (ignored by Git). No secret values here: the service token
# lives in the file named by VIETDOC_SERVICE_TOKEN_PATH (default ../secrets/, ignored).
AI_SERVICE_PORT=8090
LOG_LEVEL=INFO
AI_SERVICE_CPUS=2
AI_SERVICE_MEMORY=4g
AI_TRAIN_CPUS=4
AI_TRAIN_MEMORY=8g
# Torch wheel index for ai-train-gpu; must not exceed the host driver CUDA version.
AI_TRAIN_TORCH_INDEX=cu126
VIETDOC_MODELS_DIR=../artifacts/models
VIETDOC_DATASETS_DIR=../datasets
VIETDOC_EVALUATION_DIR=../artifacts/evaluation
VIETDOC_SERVICE_TOKEN_PATH=../secrets/ai_service_token

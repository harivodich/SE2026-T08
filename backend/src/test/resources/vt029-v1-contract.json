{
  "baseline_commit": "e5326f34549a23570ecf935f469a1f0082ed8a11",
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id",
              "details"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      },
      "DocumentPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "document_type",
          "file_bytes",
          "image_width",
          "image_height",
          "created_at",
          "version",
          "head_revision_id",
          "head",
          "job"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "receipt",
              "invoice"
            ]
          },
          "file_bytes": {
            "type": "integer"
          },
          "image_width": {
            "type": "integer"
          },
          "image_height": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer"
          },
          "head_revision_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "head": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Revision"
              },
              {
                "type": "null"
              }
            ]
          },
          "job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Job"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "document_id",
          "state",
          "stage",
          "error_code",
          "error_message",
          "attempts",
          "created_at",
          "updated_at",
          "result_run_id",
          "pipeline_manifest",
          "mode"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "RETRYING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "stage": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "result_run_id": {
            "type": "string"
          },
          "pipeline_manifest": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "Revision": {
        "type": "object",
        "required": [
          "id",
          "document_id",
          "parent_id",
          "run_id",
          "payload",
          "field_metadata",
          "issues",
          "row_ids",
          "origin",
          "reason",
          "created_at",
          "state",
          "approved_at",
          "approval_reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_id": {
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/BusinessPayload"
          },
          "field_metadata": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldMetadata"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "row_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "APPROVED"
            ]
          },
          "approved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Issue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "severity",
          "paths",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocking",
              "warning",
              "info"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FieldMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "raw_value",
          "value_origin",
          "source_regions",
          "ocr_score",
          "confidence",
          "confidence_method",
          "review_flags"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "raw_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_origin": {
            "enum": [
              "prediction",
              "human",
              "absent"
            ]
          },
          "source_regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRegion"
            }
          },
          "ocr_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "confidence_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SourceRegion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "quad",
          "ocr_block_ids"
        ],
        "properties": {
          "page": {
            "const": 0
          },
          "quad": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Point"
            }
          },
          "ocr_block_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Point": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "BusinessPayload": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Receipt"
          },
          {
            "$ref": "#/components/schemas/Invoice"
          }
        ]
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invoice_number",
          "issue_date",
          "seller_name",
          "buyer_name",
          "subtotal",
          "tax_amount",
          "discount_amount",
          "total_amount",
          "items"
        ],
        "properties": {
          "invoice_number": {
            "$ref": "#/components/schemas/NullableText"
          },
          "issue_date": {
            "$ref": "#/components/schemas/NullableDate"
          },
          "seller_name": {
            "$ref": "#/components/schemas/NullableText"
          },
          "buyer_name": {
            "$ref": "#/components/schemas/NullableText"
          },
          "subtotal": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "tax_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "discount_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "total_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "items": {
            "$ref": "#/components/schemas/Items"
          }
        }
      },
      "Items": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "$ref": "#/components/schemas/LineItem"
        }
      },
      "LineItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "quantity",
          "unit",
          "unit_price",
          "line_total"
        ],
        "properties": {
          "description": {
            "$ref": "#/components/schemas/NullableText"
          },
          "quantity": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "unit": {
            "$ref": "#/components/schemas/NullableText"
          },
          "unit_price": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "line_total": {
            "$ref": "#/components/schemas/NullableDecimal"
          }
        }
      },
      "NullableDecimal": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
        "maxLength": 32
      },
      "NullableText": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 500
      },
      "NullableDate": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "merchant_name",
          "merchant_address",
          "transaction_date",
          "transaction_time",
          "total_amount",
          "items"
        ],
        "properties": {
          "merchant_name": {
            "$ref": "#/components/schemas/NullableText"
          },
          "merchant_address": {
            "$ref": "#/components/schemas/NullableText"
          },
          "transaction_date": {
            "$ref": "#/components/schemas/NullableDate"
          },
          "transaction_time": {
            "$ref": "#/components/schemas/NullableTime"
          },
          "total_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "items": {
            "$ref": "#/components/schemas/Items"
          }
        }
      },
      "NullableTime": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
      }
    }
  }
}

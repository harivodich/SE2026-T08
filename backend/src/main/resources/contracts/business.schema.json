{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vietdoc:business:v1",
  "title": "VietDoc Vietnamese business payload v1",
  "oneOf": [{"$ref": "#/$defs/Receipt"}, {"$ref": "#/$defs/Invoice"}],
  "$defs": {
    "NullableText": {"type": ["string", "null"], "maxLength": 500},
    "NullableDecimal": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 32},
    "NullableDate": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "NullableTime": {"type": ["string", "null"], "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"},
    "LineItem": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "quantity", "unit", "unit_price", "line_total"],
      "properties": {
        "description": {"$ref": "#/$defs/NullableText"},
        "quantity": {"$ref": "#/$defs/NullableDecimal"},
        "unit": {"$ref": "#/$defs/NullableText"},
        "unit_price": {"$ref": "#/$defs/NullableDecimal"},
        "line_total": {"$ref": "#/$defs/NullableDecimal"}
      }
    },
    "Items": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/LineItem"}},
    "Receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["merchant_name", "merchant_address", "transaction_date", "transaction_time", "total_amount", "items"],
      "properties": {
        "merchant_name": {"$ref": "#/$defs/NullableText"},
        "merchant_address": {"$ref": "#/$defs/NullableText"},
        "transaction_date": {"$ref": "#/$defs/NullableDate"},
        "transaction_time": {"$ref": "#/$defs/NullableTime"},
        "total_amount": {"$ref": "#/$defs/NullableDecimal"},
        "items": {"$ref": "#/$defs/Items"}
      }
    },
    "Invoice": {
      "type": "object", "additionalProperties": false,
      "required": ["invoice_number", "issue_date", "seller_name", "buyer_name", "subtotal", "tax_amount", "discount_amount", "total_amount", "items"],
      "properties": {
        "invoice_number": {"$ref": "#/$defs/NullableText"},
        "issue_date": {"$ref": "#/$defs/NullableDate"},
        "seller_name": {"$ref": "#/$defs/NullableText"},
        "buyer_name": {"$ref": "#/$defs/NullableText"},
        "subtotal": {"$ref": "#/$defs/NullableDecimal"},
        "tax_amount": {"$ref": "#/$defs/NullableDecimal"},
        "discount_amount": {"$ref": "#/$defs/NullableDecimal"},
        "total_amount": {"$ref": "#/$defs/NullableDecimal"},
        "items": {"$ref": "#/$defs/Items"}
      }
    }
  }
}

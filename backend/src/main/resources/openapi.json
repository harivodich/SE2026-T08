  "components": {
    "schemas": {
      "NullableText": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 500
      },
      "NullableDecimal": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
        "maxLength": 32
      },
      "NullableDate": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "NullableTime": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
      },
      "LineItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "quantity",
          "unit",
          "unit_price",
          "line_total"
        ],
        "properties": {
          "description": {
            "$ref": "#/components/schemas/NullableText"
          },
          "quantity": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "unit": {
            "$ref": "#/components/schemas/NullableText"
          },
          "unit_price": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "line_total": {
            "$ref": "#/components/schemas/NullableDecimal"
          }
        }
      },
      "Items": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "$ref": "#/components/schemas/LineItem"
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "merchant_name",
          "merchant_address",
          "transaction_date",
          "transaction_time",
          "total_amount",
          "items"
        ],
        "properties": {
          "merchant_name": {
            "$ref": "#/components/schemas/NullableText"
          },
          "merchant_address": {
            "$ref": "#/components/schemas/NullableText"
          },
          "transaction_date": {
            "$ref": "#/components/schemas/NullableDate"
          },
          "transaction_time": {
            "$ref": "#/components/schemas/NullableTime"
          },
          "total_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "items": {
            "$ref": "#/components/schemas/Items"
          }
        }
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invoice_number",
          "issue_date",
          "seller_name",
          "buyer_name",
          "subtotal",
          "tax_amount",
          "discount_amount",
          "total_amount",
          "items"
        ],
        "properties": {
          "invoice_number": {
            "$ref": "#/components/schemas/NullableText"
          },
          "issue_date": {
            "$ref": "#/components/schemas/NullableDate"
          },
          "seller_name": {
            "$ref": "#/components/schemas/NullableText"
          },
          "buyer_name": {
            "$ref": "#/components/schemas/NullableText"
          },
          "subtotal": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "tax_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "discount_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "total_amount": {
            "$ref": "#/components/schemas/NullableDecimal"
          },
          "items": {
            "$ref": "#/components/schemas/Items"
          }
        }
      },
      "Point": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "SourceRegion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "quad",
          "ocr_block_ids"
        ],
        "properties": {
          "page": {
            "const": 0
          },
          "quad": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Point"
            }
          },
          "ocr_block_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "FieldMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "raw_value",
          "value_origin",
          "source_regions",
          "ocr_score",
          "confidence",
          "confidence_method",
          "review_flags"
        ],
